# ============================================================
# BOB Backend AI — Variables de Entorno
# Copia este archivo a .env para desarrollo local:
#   cp .env.example .env
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ------------------------------------------------------------
# Autenticación Interna (microservice-to-microservice)
# Header que el Backend General debe enviar en cada petición.
# ------------------------------------------------------------
INTERNAL_API_SECRET=cambia_este_secreto_en_produccion

# ------------------------------------------------------------
# IBM watsonx.ai / BOB Provider
# Prioridad de resolución: BOB_API_KEY > IBM_API_KEY > WATSONX_APIKEY > IBM_CLOUD_API_KEY
# ------------------------------------------------------------
BOB_API_KEY=tu_bob_api_key_aqui
# IBM_API_KEY=tu_ibm_api_key_aqui
# WATSONX_APIKEY=tu_watsonx_api_key_aqui
# IBM_CLOUD_API_KEY=tu_ibm_cloud_api_key_aqui

WATSONX_PROJECT_ID=tu_project_id_de_watsonx
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ------------------------------------------------------------
# Modo Mock (desarrollo sin consumir créditos de IBM)
# Cambia a "true" para respuestas simuladas sin llamar al LLM.
# ------------------------------------------------------------
BOB_MOCK_WATSONX=false

# ------------------------------------------------------------
# Entorno del servicio
# ------------------------------------------------------------
ENVIRONMENT=development
